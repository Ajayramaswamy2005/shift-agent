# Copy to .env and fill in. Never commit .env.
# Free Groq key: https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# gpt-oss is a reasoning model: keep thinking short, and leave room for it in max_tokens
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=300
LLM_TIMEOUT_S=4.0
# Gemini instead (free tier, OpenAI-compatible endpoint):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash

JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
DEV_TOKEN_ISSUER=1
# Freeze the clock for a predictable demo (optional), e.g.:
# DEMO_NOW=2026-11-19T15:00
